{
  "expo": {
    "name": "RFF",
    "slug": "RFF",
    "scheme": "rff",
    "version": "1.0.0",
    "platforms": ["android"],
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#524388",
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "imageWidth": 256,
          "dark": {
            "backgroundColor": "#524388",
            "image": "./assets/icon.png"
          }
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#524388"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#524388"
      },
      "permissions": ["com.ichi2.anki.permission.READ_WRITE_DATABASE"],
      "package": "com.colgatetotal77.RFF"
    },
    "extra": {
      "eas": {
        "projectId": "6090b552-13af-4341-b420-0e2c137e1c61"
      }
    }
  }
}
