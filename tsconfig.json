{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "*": ["*"]
    },
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["deno"]
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "supabase/functions",
    "supabase/eval"
  ]
}
